PORT=4000
# How many reverse proxies are in front of the server: 0 on your computer, 1 on Render. Without it, every user shares one login rate limit.
TRUST_PROXY=0
MONGODB_URI=mongodb://127.0.0.1:27019/english-talk
JWT_SECRET=change-me-long-random-string
# 32 bytes as 64 hex chars: openssl rand -hex 32
ENCRYPTION_KEY=
CLIENT_ORIGIN=http://localhost:5180,http://localhost:8081
# On a host (Render...) there is no .env file: these are set in its dashboard instead. CLIENT_ORIGIN only matters for a web
# build served from another address; the phone apps do not need it.
